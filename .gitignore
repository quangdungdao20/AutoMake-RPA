# =============================================================================
# AutoMake - .gitignore
# Dự án RPA Studio trên .NET 10 + WPF
# =============================================================================

# --- Visual Studio / .NET ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# .NET Core / .NET 5+ project files
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
pubxml/
*.pubxml
*.publish.xml

# NuGet
*.nupkg
*.nuget.props
*.nuget.targets
packages/
!.nuget/packages.config

# .NET CLI
dotnet.exe

# Test output
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# --- WPF / Windows Forms ---
*.csproj.user
*.vstest.*

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws

# --- Node.js / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- VitePress ---
docs/.vitepress/dist/
docs/.vitepress/cache/

# --- Operating System ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.lnk

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.temp
~$*
*~

# --- Backup files ---
*.bak
*.orig
*.swp
*~

# --- Coverage reports ---
coverage/
*.coverage
*.lcov

# --- ReSharper / Rider ---
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# --- StyleCop ---
StyleCopReport.xml

# --- NCrunch ---
*.ncrunch*
NCrunch_*
ncrunchtests_*

# --- Azure DevOps / CI ---
.vs/*
artifacts/

# --- End of file =============================================================